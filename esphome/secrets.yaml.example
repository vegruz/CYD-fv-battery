# Copiare in secrets.yaml (non committato) e sostituire TUTTI i valori.
# Chiave API (32 byte base64): generare con
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Il segnaposto sotto non è valido di proposito: ESPHome rifiuta la configurazione finché non lo si sostituisce.
wifi_ssid: "NOME_RETE"
wifi_password: "PASSWORD_WIFI"
ap_password: "CAMBIAMI"
api_encryption_key: "GENERARE_CHIAVE"
